<?xml version="1.0" encoding="utf-8"?>
<!-- 只有"启动翻译"时才需要网络；这里不需要任何明文 HTTP（全部是 https/wss） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
