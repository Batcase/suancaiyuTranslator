# 酸菜鱼翻译器 密钥模板
# 复制为 .env 后填入你自己的 Key（.env 已被 .gitignore 忽略，不会提交）。
#
# 你也可以完全不动这个文件：直接运行 `python main.py`，在主控面板的
# 「首次配置向导」里填就行——那里会真调接口验证，通过才保存。
#
# 建议：识别和翻译各配 2 家，云端服务宕机时会自动切换，字幕不会中断。

# ============ 识别引擎（语音 → 文字）============
# 阿里云百炼 · Paraformer（推荐，国内直连）： https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# Deepgram（海外服务，可作备用；国内网络有时连不上）： https://console.deepgram.com
DEEPGRAM_API_KEY=

# 硅基流动 · SenseVoice（国内，整句识别）： https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# OpenAI 实时转写（国内通常连不上，仅海外用户）： https://platform.openai.com
OPENAI_API_KEY=

# ============ 翻译引擎（外文 → 中文）============
# DeepSeek（推荐，便宜且中文口语自然）： https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 通义千问（复用上面的 DASHSCOPE_API_KEY，不用再注册一家）
#   填了 DASHSCOPE_API_KEY 就能用，作为 DeepSeek 的备用

# Kimi · 月之暗面： https://platform.moonshot.cn
MOONSHOT_API_KEY=

# 硅基流动（复用上面的 SILICONFLOW_API_KEY）
#   一个 Key 能用多家模型

# 智谱 GLM（glm-4-flash 有免费额度）： https://open.bigmodel.cn
ZHIPU_API_KEY=

# ============ 自定义接口（一般不用填）============
# 想接任意 OpenAI 兼容接口（OpenRouter / 自建 / 中转）时，用这两个覆盖地址与 Key
TRANSLATE_BASE_URL=
TRANSLATE_API_KEY=
