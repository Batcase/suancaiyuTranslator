# 统一换行符：仓库里存 LF，检出到 Windows 时自动转 CRLF
* text=auto

# 这些文件必须保持原样，不要做换行转换
*.png binary
*.jpg binary
*.ico binary
*.wav binary
*.exe binary

# Windows 脚本用 CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Python / 文档用 LF
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 避免 GitHub 把项目当成 C/Java 项目（它会按 .h/.py 统计语言）
*.h linguist-language=Python
